# ============================================================================
# 契约哨兵 ClauseGuard 环境变量模板
# 使用方式：cp .env.example .env  （.env 已被 .gitignore 忽略，切勿提交真实 Key）
# 说明：不配置任何 Key 也能完整运行——引擎会自动降级为规则模式。
# ============================================================================

# ---------- 主模型（条款审查 / 协商函 / Agent 工具决策） ----------
# 任意 OpenAI 兼容接口均可：DeepSeek、通义千问、Kimi、SiliconFlow、vLLM 自建等
CLAUSEGUARD_API_KEY=
CLAUSEGUARD_BASE_URL=https://api.deepseek.com/v1
CLAUSEGUARD_MODEL=deepseek-chat

# ---------- 视觉模型（合同照片 → 文字） ----------
# 默认智谱 GLM-4V-Flash（有免费额度）；也可换成 qwen-vl、gpt-4o-mini 等
CLAUSEGUARD_VISION_API_KEY=
CLAUSEGUARD_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CLAUSEGUARD_VISION_MODEL=glm-4v-flash

# ---------- 服务 ----------
PORT=8000
HOST=127.0.0.1

# ---------- 调试 ----------
# 置为 1 时打印条号回退等校验日志
CLAUSEGUARD_DEBUG=
